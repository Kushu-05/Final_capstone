# ==============================================================================
# RestaurantOps AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. LLM API Providers & Configuration
# ------------------------------------------------------------------------------
# Primary Cloud Provider: Anthropic Claude (e.g. sk-ant-api03-...)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Secondary Cloud Provider: NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Tertiary Cloud Provider: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fourth Cloud Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fifth Cloud Provider: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Routing & Retry Controls:
# Preferred LLM Provider: 'auto' | 'anthropic' | 'nvidia' | 'openrouter' | 'gemini' | 'openai' | 'local'
LLM_PROVIDER=auto
LLM_TIMEOUT=8.0
LLM_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 2. PostgreSQL Production Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=bharathyadav
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Search Engine
# ------------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=yelp_reviews_bge_m3

# ------------------------------------------------------------------------------
# 4. Dense Embeddings & Reranker Models
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ------------------------------------------------------------------------------
# 5. Paths & Dataset Locations
# ------------------------------------------------------------------------------
DATA_DIR=./data
YELP_REVIEWS_PATH=./archive/yelp_academic_dataset_review.json
YELP_BUSINESSES_PATH=./archive/yelp_academic_dataset_business.json
